DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/mini_ctf
DATABASE_USERNAME=mini_ctf_app
DATABASE_PASSWORD=replace-with-a-strong-database-password
FLYWAY_URL=jdbc:postgresql://127.0.0.1:5432/mini_ctf
FLYWAY_USERNAME=mini_ctf_owner
FLYWAY_PASSWORD=replace-with-a-separate-strong-owner-password
POSTGRES_DB=mini_ctf
POSTGRES_USER=mini_ctf_owner
POSTGRES_PASSWORD=replace-with-a-separate-strong-owner-password
POSTGRES_APP_USER=mini_ctf_app
POSTGRES_APP_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173
ARTIFACT_STORAGE_ROOT=../challenges
PROFILE_STORAGE=local
PROFILE_STORAGE_ROOT=../profiles
# To use AWS S3 or MinIO, set PROFILE_STORAGE=s3 and configure the five values below.
# PROFILE_S3_BUCKET=mini-ctf-profiles
# PROFILE_S3_REGION=ap-northeast-2
# PROFILE_S3_ENDPOINT=
# PROFILE_S3_ACCESS_KEY=
# PROFILE_S3_SECRET_KEY=
DIRECT_MESSAGE_RETENTION_DAYS=180
ACTIVITY_EVENT_RETENTION_DAYS=90
SECURITY_EVENT_RETENTION_DAYS=365
ANTI_CHEAT_EVENT_RETENTION_DAYS=365
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional OAuth providers. Add both values for a provider; leave these lines commented otherwise.
# Google redirect URI: http://localhost:8080/login/oauth2/code/google
# GitHub callback URL: http://localhost:8080/login/oauth2/code/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
OAUTH_FAILURE_REDIRECT=http://localhost:5173/auth/callback
INTERNAL_SERVICE_KEY=replace-with-a-separate-strong-internal-service-key
